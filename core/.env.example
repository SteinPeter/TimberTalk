# Vorlage für `.env` – keine echten Geheimnisse ins Repo.
TIMBERTALK_ENVIRONMENT=local
TIMBERTALK_DATA_DIR=data
TIMBERTALK_DATABASE_URL=sqlite+pysqlite:///data/timbertalk.db
# Platzhalter-Schlüssel für die API (Header: X-API-Key)
TIMBERTALK_API_KEY=change-me
TIMBERTALK_SQL_ECHO=false

# Optional: Postgres-URL für den zusätzlichen Migrationstest
# TEST_DATABASE_URL=postgresql+psycopg://timbertalk:timbertalk@localhost:5432/timbertalk_test
