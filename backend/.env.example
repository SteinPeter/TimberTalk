# Vorlage für backend/.env – hier stehen keine Geheimnisse.
# Alle Werte sind freiwillig; ohne Angabe gilt der Standard im Kommentar.

# Datenbank. Standard: die Datei backend/data/timbertalk.db
# TIMBERTALK_DATABASE_URL=sqlite:///./data/timbertalk.db

# Adresse, auf der der Server lauscht. Standard: 127.0.0.1 und 8000
# TIMBERTALK_HOST=127.0.0.1
# TIMBERTALK_PORT=8000
